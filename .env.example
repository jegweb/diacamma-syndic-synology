# Copier ce fichier en « .env » à côté de docker-compose.yml, puis l'adapter.

# Nom(s) de domaine utilisés pour accéder à Diacamma, séparés par des virgules.
# Obligatoire derrière le proxy inverse DSM (sinon erreur 400 Bad Request).
# Le premier nom qui n'est pas une adresse IP donne l'adresse du site dans les liens des
# courriels (https://<nom>) : en cas de changement de domaine, mettre le nouveau en premier.
DIACAMMA_ALLOWED_HOSTS=syndic.mondomaine.fr

# Utilisateur et groupe DSM propriétaires des dossiers data/ et backups/.
# En SSH : « id <utilisateur> » (le premier compte DSM a souvent 1026, groupe users = 100).
PUID=1026
PGID=100

TZ=Europe/Paris

# Accès (option A, par défaut) : le conteneur répond en HTTP sur le port 8100 du NAS,
# accessible seulement à DSM (Web Station ou proxy inversé), qui assure le HTTPS.
# Ce port se règle dans docker-compose.yml (ligne « ports »), pas ici.
DIACAMMA_HTTPS=true

# Option B : proxy inversé de la box directement vers le conteneur (sans passer par DSM).
# 1. Dans docker-compose.yml, remplacer "127.0.0.1:8100:8000" par "8100:8000".
#    La box se configure alors vers http://<IP-du-NAS>:8100.
# 2. La box doit assurer le HTTPS avec un certificat valide : garder DIACAMMA_HTTPS=true
#    (sinon les mots de passe circuleraient en clair sur Internet).
# 3. Si la box réécrit l'en-tête Host, ajouter l'IP du NAS aux hôtes autorisés, par exemple :
#      DIACAMMA_ALLOWED_HOSTS=syndic.mondomaine.fr,192.168.1.10
#    (en cas d'erreur « 400 Bad Request », c'est ce réglage qu'il faut ajuster).
# Attention : le port 8100 devient joignable en HTTP clair depuis tout le réseau local, en
# contournant le HTTPS de la box, et le pare-feu DSM ne filtre pas de façon fiable les ports
# publiés par Docker. Préférer l'option A (box -> proxy inverse DSM) si c'est possible.
#
# Essai en HTTP sur le réseau local : même changement dans docker-compose.yml, puis
# DIACAMMA_HTTPS=false et l'IP du NAS dans DIACAMMA_ALLOWED_HOSTS.

# Mot de passe initial du compte « admin » (12 caractères minimum).
# Vide : un mot de passe est généré et affiché dans le journal du conteneur.
# À retirer d'ici après la première connexion.
DIACAMMA_ADMIN_PASSWORD=

# Sauvegarde automatique quotidienne (archives .lbk dans backups/).
BACKUP_TIME=02:30
# Nombre de jours de conservation des sauvegardes automatiques (0 = illimité).
BACKUP_KEEP_DAYS=30

# --- Avancé ---
DIACAMMA_LANGUAGE=fr
# Requêtes traitées en parallèle (1 = comportement du paquet YunoHost).
GUNICORN_THREADS=1
# Réglages Django/Lucterios supplémentaires, en JSON sur une ligne, entre apostrophes.
# Exemple : DIACAMMA_EXTRA_SETTINGS='{"ETHERPAD": {"url": "https://pad.exemple.fr", "apikey": "..."}}'
# Adresse du site dans les courriels, si elle diffère de https://<premier nom autorisé> :
#   DIACAMMA_EXTRA_SETTINGS='{"LUCTERIOS_ROOT_URL": "https://syndic.mondomaine.fr:8443"}'
DIACAMMA_EXTRA_SETTINGS=
